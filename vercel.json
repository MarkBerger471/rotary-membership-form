{
  "regions": [
    "sin1"
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/send-application.js": {
      "maxDuration": 60
    },
    "api/admin/applications.js": {
      "maxDuration": 15
    },
    "api/admin/settings.js": {
      "maxDuration": 15
    },
    "api/admin/download.js": {
      "maxDuration": 15
    },
    "api/admin/vote.js": {
      "maxDuration": 60
    },
    "api/admin/contacts.js": {
      "maxDuration": 15
    },
    "api/admin/meetings.js": {
      "maxDuration": 15
    },
    "api/cron/poll.js": {
      "maxDuration": 60
    },
    "api/admin/member-photo.js": {
      "maxDuration": 15
    },
    "api/admin/resend.js": {
      "maxDuration": 60
    },
    "api/admin/guests.js": {
      "maxDuration": 15
    },
    "api/invite-image.js": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/cron/poll",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/v/:token",
      "destination": "/api/admin/vote?t=:token"
    },
    {
      "source": "/v/:token/:do",
      "destination": "/api/admin/vote?t=:token&do=:do"
    }
  ]
}
